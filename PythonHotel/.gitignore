# The virtual environment is NOT portable - it hardcodes absolute paths to
# this folder and to the Homebrew Python it was built from, so it breaks on
# any other machine (and on Apple Silicon vs Intel). Everyone recreates it
# locally with ./setup.sh; that is what requirements.txt is for.
.venv/
venv/

__pycache__/
*.pyc

# Scraped data and generated reports - large, regenerated daily, and not
# something two people should ever be merging. Delete these two lines if you
# actually do want the price history in the repo.
output/

.DS_Store
